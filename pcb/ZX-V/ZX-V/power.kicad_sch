	(text "Alimentación: 5 V por el USB-C (solo la corriente) y el interruptor de encendido."
		(exclude_from_sim no)
		(at 25.4 25.4 0)
		(effects
				(font
					(size 2 2)
				)
				(justify left top)
			)
		(uuid "152455ac-34cd-4a9f-bdb6-792e71e80a7d")
	)
	(text "R1 y R2 (5,1 kΩ en CC1 y CC2) piden 5 V al cargador.\nEncendido: con SW3 en ON, la puerta de Q1 va a masa por R41 y Q1 conduce. C16 con R41 da un\narranque suave (~1 ms); R40 la apaga. El interruptor no lleva la corriente: la lleva Q1."
		(exclude_from_sim no)
		(at 25.4 160.02 0)
		(effects
				(font
					(size 1.27 1.27)
				)
				(justify left top)
			)
		(uuid "00e7e62e-e50f-4bd2-82dd-b715ce520e6c")
	)
	(text "ON"
		(exclude_from_sim no)
		(at 170.18 63.5 0)
		(effects
				(font
					(size 1.27 1.27)
				)
				(justify left top)
			)
		(uuid "33fabc3f-d93a-4f59-9e29-4e7e6bf1124d")
	)
